# Copy to .env and edit. Never commit .env.

# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# Banks (tenants). Each gets its own isolated graph: bank_<tenant>
TENANT=demobank
TENANTS=demobank,suraksha

# How agents reach the tools: mcp (real MCP server over stdio) or local (direct import)
TOOL_TRANSPORT=mcp

# LLM: none | anthropic | openai
#   none      -> agents follow their graph playbooks (no API key needed, fully deterministic demo)
#   anthropic -> LLM_API_KEY=sk-ant-...  LLM_MODEL=claude-haiku-5-5
#   openai    -> any OpenAI-compatible API, e.g.
#                Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=<model>
#                Ollama: LLM_BASE_URL=http://localhost:11434/v1       LLM_MODEL=<model>
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
